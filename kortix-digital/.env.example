# Copy to .env.local and fill in. Never commit real keys.

# Canonical origin used for canonicals, og:url, sitemap, robots.txt, JSON-LD and
# the host redirects. Defaults to the www host in src/lib/site.ts if unset.
# Change this AND the hosting redirect together if you ever flip to the apex host.
NEXT_PUBLIC_SITE_URL=https://www.kortixdigital.com

# Google Search Console verification token (the content value of the
# google-site-verification meta tag). Leave empty to omit the tag entirely.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# GA4 measurement ID (G-XXXXXXX). Analytics does not load at all until this is
# set AND a visitor has accepted cookies in the consent banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Brevo transactional email for the /request form (server-side only, never
# exposed to the browser).
BREVO_API_KEY=
BREVO_RECIPIENT=
